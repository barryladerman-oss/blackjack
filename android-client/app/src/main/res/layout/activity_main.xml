<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#8B7355"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blackjack"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#D4A76A"
                android:gravity="center"/>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⚙"
                android:textSize="24sp"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Server Configuration -->
        <LinearLayout
            android:id="@+id/configLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Server URL"
                android:text="http://10.0.2.2:8080/"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:inputType="textUri"/>

            <Button
                android:id="@+id/connectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"
                android:layout_marginRight="4dp"/>

            <Button
                android:id="@+id/exitButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exit"
                android:backgroundTint="#8B4513"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Game Stats -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#A0826D"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/countingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Running Count: 0 | True Count: 0.0"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/cardsRemainingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cards Remaining: 52"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dealer Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#A0826D"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dealer"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#D4A76A"/>

                <TextView
                    android:id="@+id/dealerCardsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No cards"
                    android:textSize="24sp"
                    android:textColor="#FFFFFF"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:id="@+id/dealerValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total: 0"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Player Hands Container -->
        <LinearLayout
            android:id="@+id/playerHandsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <!-- Player hands will be added dynamically here -->
        </LinearLayout>

        <!-- New Game Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/newGameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Game"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"
                android:layout_margin="4dp"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"/>
        </LinearLayout>

        <!-- Hidden global buttons for compatibility -->
        <Button
            android:id="@+id/hitButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/doubleButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/splitButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <Button
            android:id="@+id/standButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <!-- Status Message -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#F5DEB3"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"/>

    </LinearLayout>
</ScrollView>
