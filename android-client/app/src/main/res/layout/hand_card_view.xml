<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#A0826D"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/handTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hand 1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D4A76A"/>

        <TextView
            android:id="@+id/handCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No cards"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/handValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: 0"
            android:textSize="16sp"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/handStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#F5DEB3"
            android:paddingTop="4dp"/>

        <TextView
            android:id="@+id/handRecommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#D2B48C"
            android:paddingTop="4dp"/>

        <TextView
            android:id="@+id/handOutcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D4A76A"
            android:paddingTop="4dp"/>

        <!-- Hand Action Buttons -->
        <LinearLayout
            android:id="@+id/handButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/handHitButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hit"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:textSize="12sp"
                android:padding="4dp"/>

            <Button
                android:id="@+id/handDoubleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Double"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:textSize="12sp"
                android:padding="4dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/handSplitButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Split"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:textSize="12sp"
                android:padding="4dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/handStandButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stand"
                android:backgroundTint="#C19A6B"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:textSize="12sp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Insurance Buttons -->
        <LinearLayout
            android:id="@+id/insuranceButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/insuranceButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Insurance"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:textSize="12sp"
                android:padding="4dp"/>

            <Button
                android:id="@+id/declineInsuranceButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No Insurance"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:layout_margin="2dp"
                android:textSize="12sp"
                android:padding="4dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
