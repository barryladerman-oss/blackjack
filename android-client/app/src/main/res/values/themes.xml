<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BlackjackClient" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blackjack_dark_green</item>
        <item name="colorPrimaryVariant">@color/blackjack_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/blackjack_gold</item>
        <item name="colorSecondaryVariant">@color/blackjack_yellow</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/blackjack_green</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/blackjack_green</item>
    </style>
</resources>
